    "_doc": {
        "_": "Acervo Gamer - Schema de dados para jogos",
        "name": "Nome do jogo exibido no site",
        "slug": "Identificador único do jogo (usado nas URLs: #/jogos/{slug})",
        "genre": "Gênero do jogo (ex: RPG, Aventura, Terror)",
        "developer": "Estúdio ou pessoa que desenvolveu o jogo",
        "year": "Ano de lançamento original do jogo",
        "cover": "URL da imagem de capa do jogo. Exibida nos cards e na página de detalhes. Aceita qualquer URL de imagem (Steam CDN, Imgur, etc). Se omitido, o card não mostra imagem.",
        "background": "URL da imagem de fundo da página de detalhes do jogo. Aparece atrás do título e descrição na página individual. Se omitido, usa fundo escuro padrão.",
        "bannerGif": "URL de um GIF animado para o banner da página de detalhes do jogo. Roda em loop como fundo do cabeçalho. Se omitido, usa a imagem estática do campo 'background'.",
        "shortDescription": "Descrição curta do jogo (1-2 frases). Exibida nos cards na listagem de jogos.",
        "fullDescription": "Descrição completa do jogo. Exibida na aba 'Visão Geral' da página de detalhes.",
        "videoPreview": "URL de embed do YouTube do trailer do jogo (formato: https://www.youtube.com/embed/{ID}). Exibido na aba 'Visão Geral'. Se omitido, aba sem trailer.",
        "previewGif": "URL de um GIF animado do jogo. Exibido como preview ao passar o mouse sobre o card (hover). Se omitido, card mostra apenas a capa estática.",
        "translations": "Lista de traduções disponíveis para o jogo. Cada item deve ter: name, version, date (YYYY-MM-DD), size, downloadUrl, officialUrl (opcional - URL do site oficial da tradução. Se ausente, nenhum link 'Oficial' é exibido)",
        "mods": "Lista de mods disponíveis para o jogo. Cada item deve ter: name, version, author, downloadUrl, officialUrl (opcional - URL do site oficial do mod. Se ausente, nenhum link 'Oficial' é exibido)",
        "stores": "Lista de lojas onde o jogo pode ser comprado. Cada item deve ter: store (nome da loja), url (link direto para compra), platform (plataforma), price (preço em R$), priceOriginal (preço original sem conversão), coupon (cupom de desconto, opcional), lastUpdated (data da última atualização do preço)",
        "soundtrack": "Lista de músicas da trilha sonora. Cada item deve ter: title, artist, duration (ex: '3:45'), extra (opcional - informação extra exibida ao lado do artista, ex: 'Cap. 1'), spotifyUrl (opcional), youtubeUrl (opcional), audioUrl (opcional - URL direta de áudio MP3/OGG para tocar no player. Se ausente, clica no YouTube)",
        "gameplays": "Lista de vídeos de gameplay. Cada item deve ter: title, channelName (nome do canal), channelUrl (URL do canal), embedUrl (YouTube embed), youtubeUrl (link direto)"
